# Broker (moomoo OpenD)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PASSWORD_MD5=
MOOMOO_TRADE_ENV=SIMULATE
# acc_id: 0 = 先頭口座。明示指定する場合は scripts/check_acc_list.py の結果から取得して設定
MOOMOO_ACC_ID=0
# JP口座区分: JP_GENERAL=一般 / JP_TOKUTEI=特定 / JP_NISA_GENERAL=一般NISA 等
MOOMOO_JP_ACC_TYPE=JP_TOKUTEI

# 株価データ取得元: yfinance（既定）or moomoo
# 未設定時はコードのデフォルト（yfinance）が使われる。
# moomoo を使う場合は OpenD が起動している環境で明示的に moomoo を指定すること
# （OpenD 未起動でも例外にならず、価格キャッシュが黙って更新されなくなるため）。
DATA_SOURCE=yfinance

# Trading
DRY_RUN=true
MAX_POSITIONS=3
RISK_PER_TRADE_PCT=0.02
MAX_PORTFOLIO_EXPOSURE_PCT=0.90
DAILY_LOSS_LIMIT_PCT=0.03
# キャンペーン取得株などポジション枠を消費させない銘柄（カンマ区切り、システムが自分で買えば自動的に枠消費に戻る）
IGNORED_TICKERS=

# Database (PostgreSQL)
DATABASE_URL=postgresql://autotrd:password@localhost:5432/autotrd

# Notification (Slack Incoming Webhook)
SLACK_WEBHOOK_URL=

# Timezone
TZ=Asia/Tokyo

# 外部API (Wikipedia等) アクセス時の User-Agent に含める連絡先
# Wikimedia User-Agent policy 準拠。未設定時は警告ログを出して継続。
CONTACT_EMAIL=
