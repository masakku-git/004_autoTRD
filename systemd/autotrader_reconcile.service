[Unit]
Description=AutoTRD Fill Reconciliation
After=network.target opend.service
OnFailure=autotrader_failure_notify@%n.service

[Service]
Type=oneshot
User=trader
WorkingDirectory=/home/trader/autoTRD
ExecStart=/home/trader/autoTRD/.venv/bin/python /home/trader/autoTRD/scripts/reconcile_fills.py
Environment=PYTHONPATH=/home/trader/autoTRD
EnvironmentFile=/home/trader/autoTRD/.env
